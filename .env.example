# Finora AI Configuration Template

# General API settings
DEBUG=False

# Security & Authentication Secrets
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY
JWT_REFRESH_SECRET=YOUR_SECURE_JWT_REFRESH_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Leave MONGODB_URI empty to automatically fall back to SQLite for local development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=finora_db

# Machine Learning & Data Paths (Optional - defaults to relative paths)
# SQLITE_PATH=backend/finora.db
# MODEL_PATH=model/Personal_Finance_Model.pkl
# MAPPINGS_PATH=model/categorical_mappings.json
# MEDIANS_PATH=model/column_medians.json

# Gemini AI Assistant Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
